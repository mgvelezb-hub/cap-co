{
  "crons": [
    {
      "path": "/api/cron/seguimiento?turno=manana",
      "schedule": "30 15 * * 1-5"
    },
    {
      "path": "/api/cron/seguimiento?turno=tarde",
      "schedule": "30 19 * * 1-5"
    }
  ],
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ../lib ../package-lock.json"
}
