{
  "name": "capco-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node scripts/migrate.mjs",
    "eval": "node --env-file=.env.local --no-warnings scripts/eval-chat.mjs",
    "db:local": "pg_ctl -D .pgdata -o \"-p 5499 -k /tmp\" -l .pgdata/log start && node --env-file=.env.local scripts/migrate.mjs",
    "db:local:init": "initdb -D .pgdata -U capco --auth=trust -E UTF8 --locale=C && pg_ctl -D .pgdata -o \"-p 5499 -k /tmp\" -l .pgdata/log start && sleep 2 && psql -h 127.0.0.1 -p 5499 -U capco -d postgres -c \"create database capco\" && node --env-file=.env.local scripts/migrate.mjs",
    "test:db": "node --env-file=.env.local --test tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@react-three/fiber": "^9.6.1",
    "next": "^15.3.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
